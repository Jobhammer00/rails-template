#!/usr/bin/env ruby
# Gives an app generated from this template its own name, once, right after it is created:
#   bin/rename klantportaal [port]
# Replaces rails_template / rails-template / RailsTemplate / "Rails Template" in every tracked file,
# and the dev port 3099 when a port is given (pick a free one, rules/dev-environment.md).
require "active_support/core_ext/string/inflections"

name, port = ARGV
abort "Usage: bin/rename <name_in_snake_case> [port]" unless name&.match?(/\A[a-z][a-z0-9_]*\z/)

replacements = {
  "rails_template" => name,
  "rails-template" => name.dasherize,
  "RailsTemplate" => name.camelize,
  "Rails Template" => name.titleize
}
replacements["3099"] = port if port

files = `git ls-files -z`.split("\0").reject { |file| File.symlink?(file) || file.start_with?("bin/rename") }
files.each do |file|
  text = File.binread(file)
  next unless text.valid_encoding? && text.force_encoding("UTF-8").valid_encoding?

  renamed = replacements.reduce(text) { |result, (from, to)| result.gsub(from, to) }
  File.write(file, renamed) unless renamed == text
end

puts "Renamed to #{name.camelize}. Next: bin/rails credentials:edit, then commit."
