<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), t("app.name") ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= t("app.name") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">
    <% if authenticated? %>
      <header class="border-b border-border">
        <nav class="mx-auto flex max-w-5xl items-center gap-6 px-5 py-3 text-sm">
          <%= link_to t("app.name"), root_path, class: "font-semibold" %>
          <%= link_to t("nav.dashboard"), root_path, class: "text-muted-foreground hover:text-foreground" %>
          <%= link_to t("nav.settings"), settings_path, class: "text-muted-foreground hover:text-foreground" %>
          <%= button_to t("nav.sign_out"), session_path, method: :delete, form_class: "ml-auto", class: "text-muted-foreground hover:text-foreground cursor-pointer" %>
        </nav>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl px-5 py-10">
      <%= render Components::FlashMessages.new(flash:) %>
      <%= yield %>
    </main>
  </body>
</html>
